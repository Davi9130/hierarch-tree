{
  "name": "facial-check",
  "version": "0.1.0",
  "description": "Modular SDK for camera capture, face detection, facial analysis and Face Liveness challenges, with a framework-agnostic core and React bindings.",
  "license": "MIT",
  "author": "Davi da Costa",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Davi9130/hierarch-tree.git",
    "directory": "packages/facial-check"
  },
  "bugs": {
    "url": "https://github.com/Davi9130/hierarch-tree/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./react": {
      "import": {
        "types": "./dist/react.d.ts",
        "default": "./dist/react.js"
      },
      "require": {
        "types": "./dist/react.d.cts",
        "default": "./dist/react.cjs"
      }
    },
    "./core": {
      "import": {
        "types": "./dist/core.d.ts",
        "default": "./dist/core.js"
      },
      "require": {
        "types": "./dist/core.d.cts",
        "default": "./dist/core.cjs"
      }
    },
    "./detectors": {
      "import": {
        "types": "./dist/detectors.d.ts",
        "default": "./dist/detectors.js"
      },
      "require": {
        "types": "./dist/detectors.d.cts",
        "default": "./dist/detectors.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build",
    "prepublishOnly": "npm run check"
  },
  "keywords": [
    "face",
    "face-detection",
    "facial-landmarks",
    "liveness",
    "face-liveness",
    "blink-detection",
    "head-pose",
    "camera",
    "face-api.js",
    "mediapipe",
    "react",
    "typescript"
  ],
  "dependencies": {
    "@mediapipe/tasks-vision": "1.2.3",
    "face-api.js": "0.22.2"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "jsdom": "^31.0.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsup": "^9.0.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.74.0",
    "vitest": "^5.1.2"
  }
}
