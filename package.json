{
  "name": "hierarch-tree",
  "version": "0.1.0",
  "description": "Generic, domain-agnostic core for multi-level entity structures: configurable identity, occurrences, relationship rules and validation.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./zod": {
      "types": "./dist/adapters/zod/index.d.ts",
      "import": "./dist/zod.js"
    },
    "./zustand": {
      "types": "./dist/adapters/zustand/index.d.ts",
      "import": "./dist/zustand.js"
    },
    "./react-hook-form": {
      "types": "./dist/adapters/react-hook-form/index.d.ts",
      "import": "./dist/react-hook-form.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "pnpm typecheck && pnpm test && pnpm build"
  },
  "keywords": [
    "tree",
    "hierarchy",
    "entity",
    "structure",
    "relationships",
    "typescript",
    "react-hook-form"
  ],
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-hook-form": "^7.92.0",
    "zod": "^4.0.0",
    "zustand": ">=5.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-hook-form": {
      "optional": true
    },
    "zod": {
      "optional": true
    },
    "zustand": {
      "optional": true
    }
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "jsdom": "^31.0.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.92.0",
    "tsup": "^9.0.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
  }
}
